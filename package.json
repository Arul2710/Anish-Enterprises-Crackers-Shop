{
  "name": "anish-enterprises",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Anish Enterprises - Crackers Shop. Frontend-only React + Vite storefront and admin workspace. All data lives in the browser (localStorage); there is no server, API or database.",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
